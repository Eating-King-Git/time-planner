  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
