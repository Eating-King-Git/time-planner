{
  "name": "time-planner",
  "version": "0.2.1",
  "description": "本地优先的 Windows 桌面时间规划工具：中文任务输入、四象限分类、当日排程、桌面提醒与未完成任务延续。无需账号或大模型 API。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "license": "MIT"
}
